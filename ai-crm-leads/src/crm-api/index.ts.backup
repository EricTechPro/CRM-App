  async fetch(request: Request): Promise<Response> {
    // Initialize storage with sample data
    this.initializeStorage();
    // Add CORS headers
    const corsHeaders = {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
      'Content-Type': 'application/json'
    };

    // Handle preflight OPTIONS requests
    if (request.method === 'OPTIONS') {
      return new Response(null, { 
        status: 204,
        headers: corsHeaders
      });
    }

    try {
      const url = new URL(request.url);
      const pathname = url.pathname;

      this.env.logger.info(`API Request: ${request.method} ${pathname}`);

      // Route requests
      if (pathname.startsWith('/api/leads') && request.method === 'GET') {
        return await this.getLeads(request, corsHeaders);
      } else if (pathname === '/api/leads' && request.method === 'POST') {
        return await this.createLead(request, corsHeaders);
      } else if (pathname.match(/^\/api\/leads\/[^/]+$/) && request.method === 'PUT') {
        return await this.updateLead(request, corsHeaders);
      } else if (pathname.match(/^\/api\/leads\/[^/]+$/) && request.method === 'DELETE') {
        return await this.deleteLead(request, corsHeaders);
      } else if (pathname === '/api/query' && request.method === 'POST') {
        return await this.naturalLanguageQuery(request, corsHeaders);
      } else if (pathname === '/api/documents/analyze' && request.method === 'POST') {
        return await this.analyzeDocument(request, corsHeaders);
      } else if (pathname === '/api/insights/patterns' && request.method === 'GET') {
        return await this.getInsightPatterns(request, corsHeaders);
      } else if (pathname === '/api/memory/learn' && request.method === 'POST') {
        return await this.learnPattern(request, corsHeaders);
      } else if (pathname === '/api/leads/score/realtime' && request.method === 'GET') {
        return await this.getRealtimeScores(request, corsHeaders);
      }

      return new Response(
        JSON.stringify({ error: 'Not found', path: pathname }), 
        { 
          status: 404, 
          headers: corsHeaders 
        }
      );

    } catch (error) {
      this.env.logger.error(`API Error: ${error}`);
      return new Response(
        JSON.stringify({ 
          error: 'Internal server error', 
          message: error instanceof Error ? error.message : 'Unknown error' 
        }),
        { 
          status: 500, 
          headers: corsHeaders 
        }
      );
    }
  }

