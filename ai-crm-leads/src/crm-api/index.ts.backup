  // POST /api/leads - Create new lead with AI scoring
  private async createLead(request: Request, headers: Record<string, string>): Promise<Response> {
    const body = await request.json();
    const validatedLead = LeadSchema.parse(body);

    // Get AI-powered lead score
    const leadScore = await this.calculateLeadScore(validatedLead);
    
    const leadId = crypto.randomUUID();
    const now = new Date().toISOString();
    
    const insertQuery = `
      INSERT INTO leads (id, name, email, phone, company, source, status, score, notes, industry, companySize, stage, location, created_at, updated_at)
      VALUES ('${leadId}', '${validatedLead.name}', '${validatedLead.email}', 
              '${validatedLead.phone || ''}', '${validatedLead.company || ''}', 
              '${validatedLead.source || 'api'}', '${validatedLead.status || 'new'}', 
              ${leadScore}, '${validatedLead.notes || ''}', '${validatedLead.industry || ''}',
              '${validatedLead.companySize || ''}', '${validatedLead.stage || 'new'}',
              '${validatedLead.location || ''}', '${now}', '${now}')
    `;

    // Store in memory for immediate availability
    const newLead = {
      id: leadId,
      name: validatedLead.name,
      email: validatedLead.email,
      phone: validatedLead.phone || '',
      company: validatedLead.company || '',
      source: validatedLead.source || 'api',
      status: validatedLead.status || 'new',
      score: leadScore,
      notes: validatedLead.notes || '',
      industry: validatedLead.industry || '',
      companySize: validatedLead.companySize || '',
      stage: validatedLead.stage || 'new',
      location: validatedLead.location || '',
      created_at: now,
      updated_at: now
    };
    
    this.leads.set(leadId, newLead);
    
    // Also try to store in database (may fail silently)
    try {
      await this.env.CRM_DATABASE.executeQuery({ sqlQuery: insertQuery });
    } catch (error) {
      console.warn('Database storage failed, using in-memory only:', error);
    }

    // Queue for pattern learning
    await this.env.AI_PROCESSING.send({
      eventType: 'lead_qualified',
      leadId,
      userId: 'api-user',
      timestamp: now,
      conversionData: {
        leadScore,
        companySize: 'unknown',
        industry: 'unknown',
        region: 'unknown',
        painPoints: [],
        decisionMakers: [],
        sourceChannel: validatedLead.source || 'api',
        touchpoints: [],
        documentsShared: [],
        meetingCount: 0,
        emailCount: 0,
        responseTime: 0,
        salesCycle: 0,
        conversionStage: 'new'
      }
    });

    return new Response(JSON.stringify(newLead), { 
      status: 201, 
      headers 
    });
  }

  // PUT /api/leads/:id - Update lead
  private async updateLead(request: Request, headers: Record<string, string>): Promise<Response> {
    const url = new URL(request.url);
    const leadId = url.pathname.split('/').pop()!;
    const body = await request.json();
    const validatedLead = LeadSchema.partial().parse(body);

    // Check if lead exists
    const existingResult = await this.env.CRM_DATABASE.executeQuery({
      sqlQuery: `SELECT * FROM leads WHERE id = '${leadId}'`
    });

    let existingLead;
    try {
      const parsed = JSON.parse(existingResult.results || '[]');
      existingLead = Array.isArray(parsed) && parsed.length > 0 ? parsed[0] : null;
    } catch {
      existingLead = null;
    }

    if (!existingLead) {
      return new Response(JSON.stringify({ error: 'Lead not found' }), { 
        status: 404, 
        headers 
      });
    }

    // Recalculate score if relevant fields changed
    let score = validatedLead.score;
    if (!score && (validatedLead.company || validatedLead.source || validatedLead.email)) {
      const fullLead = { ...existingLead, ...validatedLead };
      score = await this.calculateLeadScore(fullLead as Lead);
    }

    const updateFields: string[] = [];
    
    Object.entries(validatedLead).forEach(([key, value]) => {
      if (value !== undefined && key !== 'id') {
        updateFields.push(`${key} = '${value}'`);
      }
    });

    if (score !== undefined) {
      updateFields.push(`score = ${score}`);
    }

    updateFields.push(`updated_at = '${new Date().toISOString()}'`);

    const updateQuery = `
      UPDATE leads 
      SET ${updateFields.join(', ')}
      WHERE id = '${leadId}'
    `;

    await this.env.CRM_DATABASE.executeQuery({ sqlQuery: updateQuery });

    // Get updated lead
    const updatedResult = await this.env.CRM_DATABASE.executeQuery({
      sqlQuery: `SELECT * FROM leads WHERE id = '${leadId}'`
    });

    let updatedLead;
    try {
      const parsed = JSON.parse(updatedResult.results || '[]');
      updatedLead = Array.isArray(parsed) && parsed.length > 0 ? parsed[0] : null;
    } catch {
      updatedLead = null;
    }

    return new Response(JSON.stringify(updatedLead), { headers });
  }

  // DELETE /api/leads/:id - Delete lead
  private async deleteLead(request: Request, headers: Record<string, string>): Promise<Response> {
    const url = new URL(request.url);
    const leadId = url.pathname.split('/').pop()!;

    const result = await this.env.CRM_DATABASE.executeQuery({
      sqlQuery: `DELETE FROM leads WHERE id = '${leadId}'`
    });

    if (result.status !== 200) {
      return new Response(JSON.stringify({ error: 'Lead not found or could not be deleted' }), { 
        status: 404, 
        headers 
      });
    }

    return new Response(JSON.stringify({ success: true }), { headers });
  }

  // POST /api/query - Natural language database queries
  private async naturalLanguageQuery(request: Request, headers: Record<string, string>): Promise<Response> {
    const body = await request.json();
    const { query, table } = QuerySchema.parse(body);

    try {
      const result = await this.env.CRM_DATABASE.executeQuery({ textQuery: query });
      
      let results = [];
      if (result.results) {
        try {
          results = JSON.parse(result.results);
        } catch {
          results = [];
        }
      }
      
      return new Response(JSON.stringify({
        query: result.queryExecuted,
        results,
        rowCount: Array.isArray(results) ? results.length : 0,
        aiReasoning: result.aiReasoning
      }), { headers });
      
    } catch (error) {
      this.env.logger.error(`Natural language query error: ${error}`);
      return new Response(JSON.stringify({ 
        error: 'Query execution failed',
        message: error instanceof Error ? error.message : 'Unknown error'
      }), { 
        status: 400, 
        headers 
      });
    }
  }

  // POST /api/documents/analyze - AI document processing
  private async analyzeDocument(request: Request, headers: Record<string, string>): Promise<Response> {
    const body = await request.json();
    const { document_key, document_type } = DocumentAnalyzeSchema.parse(body);

    // Get document from SmartBucket
    const document = await this.env.SALES_DOCUMENTS.get(document_key);
    if (!document) {
      return new Response(JSON.stringify({ error: 'Document not found' }), { 
        status: 404, 
        headers 
      });
    }

    const documentText = await document.text();
    
    // AI analysis prompt
    const analysisPrompt = `Analyze this ${document_type || 'business'} document and extract key information:
    
Document content:
${documentText}

Please provide a JSON response with:
1. summary: Brief summary of the document
2. key_points: Array of important points
3. entities: Extracted names, companies, dates, amounts
4. sentiment: positive/negative/neutral
5. action_items: Things that need to be done
6. priority: high/medium/low based on content
`;

    const aiResponse = await this.env.AI.run('@cf/meta/llama-3-8b-instruct', {
      messages: [{ role: 'user', content: analysisPrompt }]
    });

    let analysis;
    try {
      const responseText = typeof aiResponse === 'object' && 'response' in aiResponse ? aiResponse.response as string : String(aiResponse);
      analysis = JSON.parse(responseText);
    } catch {
      // If AI didn't return valid JSON, structure the response
      const responseText = typeof aiResponse === 'object' && 'response' in aiResponse ? aiResponse.response as string : String(aiResponse);
      analysis = {
        summary: responseText ? responseText.substring(0, 500) : 'Document analyzed',
        key_points: [],
        entities: {},
        sentiment: 'neutral',
        action_items: [],
        priority: 'medium'
      };
    }

    // Store analysis in SmartMemory
    const memorySession = await this.env.AI_INSIGHTS.startWorkingMemorySession();
    await memorySession.workingMemory.putMemory({
      content: JSON.stringify(analysis),
      key: `document_analysis_${document_key}`,
      timeline: 'document_analysis'
    });

    return new Response(JSON.stringify({
      document_key,
      analysis,
      processed_at: new Date().toISOString()
    }), { headers });
  }

  // GET /api/insights/patterns - AI learning recommendations
  private async getInsightPatterns(request: Request, headers: Record<string, string>): Promise<Response> {
    const url = new URL(request.url);
    const type = url.searchParams.get('type') || 'all';
    const limit = parseInt(url.searchParams.get('limit') || '10');

    // Get conversion patterns from vector index
    const conversionPatterns = await this.env.CONVERSION_PATTERNS.query([0.1, 0.2, 0.3], { topK: limit });
    
    // Get insights from SmartMemory
    const memorySession = await this.env.AI_INSIGHTS.startWorkingMemorySession();
    const insights = await memorySession.workingMemory.getMemory({ 
      timeline: 'insights',
      nMostRecent: limit 
    }) || [];

    // Get lead statistics for patterns
    const leadStatsResult = await this.env.CRM_DATABASE.executeQuery({
      sqlQuery: `
        SELECT 
          status,
          COUNT(*) as count,
          AVG(score) as avg_score,
          source,
          DATE(created_at) as date
        FROM leads 
        WHERE created_at >= date('now', '-30 days')
        GROUP BY status, source, DATE(created_at)
        ORDER BY date DESC
        LIMIT 50
      `
    });

    let leadStats = [];
    try {
      leadStats = JSON.parse(leadStatsResult.results || '[]');
    } catch {
      leadStats = [];
    }

    // Use AI to generate insights
    const insightPrompt = `Based on this CRM data, provide insights and recommendations:

Lead Statistics:
${JSON.stringify(leadStats, null, 2)}

Recent Patterns:
${JSON.stringify(insights.slice(0, 5), null, 2)}

Please provide actionable insights about:
1. Lead conversion patterns
2. Best performing sources
3. Scoring accuracy trends
4. Recommendations for improvement
5. Potential issues or opportunities

Format as JSON with insights array.`;

    const aiResponse = await this.env.AI.run('@cf/meta/llama-3-8b-instruct', {
      messages: [{ role: 'user', content: insightPrompt }]
    });

    let aiInsights;
    try {
      const responseText = typeof aiResponse === 'object' && 'response' in aiResponse ? aiResponse.response as string : String(aiResponse);
      aiInsights = JSON.parse(responseText);
    } catch {
      const responseText = typeof aiResponse === 'object' && 'response' in aiResponse ? aiResponse.response as string : String(aiResponse);
      aiInsights = { insights: [responseText || 'No insights available'] };
    }

    return new Response(JSON.stringify({
      patterns: {
        conversion: conversionPatterns,
        lead_statistics: leadStats,
        ai_insights: aiInsights,
        memory_insights: insights.slice(0, 5)
      },
      generated_at: new Date().toISOString()
    }), { headers });
  }

  // POST /api/memory/learn - SmartMemory pattern storage
  private async learnPattern(request: Request, headers: Record<string, string>): Promise<Response> {
    const body = await request.json();
    const { pattern_data, pattern_type, metadata } = LearnSchema.parse(body);

    const patternId = crypto.randomUUID();
    const timestamp = new Date().toISOString();
    
    const patternEntry = {
      id: patternId,
      type: pattern_type,
      data: pattern_data,
      metadata: metadata || {},
      created_at: timestamp
    };

    // Store in SmartMemory
    const memorySession = await this.env.AI_INSIGHTS.startWorkingMemorySession();
    await memorySession.workingMemory.putMemory({
      content: JSON.stringify(patternEntry),
      key: `pattern_${pattern_type}_${patternId}`,
      timeline: 'pattern_learning'
    });

    // If it's a conversion pattern, also store in vector index
    if (pattern_type === 'conversion' && pattern_data.features) {
      const embedding = await this.generateEmbedding(JSON.stringify(pattern_data));
      await this.env.CONVERSION_PATTERNS.upsert([{
        id: patternId,
        values: embedding,
        metadata: { type: pattern_type, ...metadata }
      }]);
    }

    // Queue for further processing
    await this.env.AI_PROCESSING.send({
      eventType: 'conversion_success',
      leadId: 'pattern-learning',
      userId: 'system',
      timestamp,
      conversionData: {
        leadScore: 0,
        companySize: 'unknown',
        industry: 'unknown',
        region: 'unknown',
        painPoints: [],
        decisionMakers: [],
        sourceChannel: 'pattern-learning',
        touchpoints: [],
        documentsShared: [],
        meetingCount: 0,
        emailCount: 0,
        responseTime: 0,
        salesCycle: 0,
        conversionStage: 'system'
      }
    });

    return new Response(JSON.stringify({
      pattern_id: patternId,
      stored: true,
      timestamp
    }), { 
      status: 201, 
      headers 
    });
  }

  // GET /api/leads/score/realtime - Live scoring updates
  private async getRealtimeScores(request: Request, headers: Record<string, string>): Promise<Response> {
    const url = new URL(request.url);
    const leadIds = url.searchParams.get('ids')?.split(',') || [];
    
    if (leadIds.length === 0) {
      return new Response(JSON.stringify({ error: 'No lead IDs provided' }), { 
        status: 400, 
        headers 
      });
    }

    // Get current leads
    const idsQuery = leadIds.map(id => `'${id}'`).join(',');
    const leadsResult = await this.env.CRM_DATABASE.executeQuery({
      sqlQuery: `SELECT * FROM leads WHERE id IN (${idsQuery})`
    });

    let leads = [];
    try {
      leads = JSON.parse(leadsResult.results || '[]');
    } catch {
      leads = [];
    }

    const scores: Record<string, number> = {};
    
    // Calculate real-time scores for each lead
    for (const lead of leads) {
      const score = await this.calculateLeadScore(lead as Lead);
      scores[lead.id as string] = score;
      
      // Update database if score changed significantly
      const currentScore = lead.score as number || 0;
      if (Math.abs(score - currentScore) > 5) {
        await this.env.CRM_DATABASE.executeQuery({
          sqlQuery: `UPDATE leads SET score = ${score}, updated_at = '${new Date().toISOString()}' WHERE id = '${lead.id}'`
        });
      }
    }

    return new Response(JSON.stringify({
      scores,
      updated_at: new Date().toISOString(),
      leads_processed: Object.keys(scores).length
    }), { headers });
  }

  // Helper: Calculate AI-powered lead score
  private async calculateLeadScore(lead: Lead): Promise<number> {
    const scoringPrompt = `Score this lead from 0-100 based on conversion likelihood:

Lead Data:
- Name: ${lead.name}
- Email: ${lead.email}
- Company: ${lead.company || 'Not provided'}
- Phone: ${lead.phone || 'Not provided'}
- Source: ${lead.source || 'Unknown'}
- Status: ${lead.status || 'new'}

Scoring criteria:
- Company email domain (+20)
- Phone number provided (+15)  
- Professional email format (+10)
- Known high-value source (+25)
- Complete profile (+10)

Return only the numeric score (0-100).`;

    try {
      const response = await this.env.AI.run('@cf/meta/llama-3-8b-instruct', {
        messages: [{ role: 'user', content: scoringPrompt }]
      });
      
      const responseText = typeof response === 'object' && 'response' in response ? response.response as string : String(response);
      const score = parseInt((responseText || '50').match(/\d+/)?.[0] || '50');
      return Math.min(100, Math.max(0, score));
    } catch (error) {
      this.env.logger.error(`Score calculation error: ${error}`);
      return 50; // Default score on error
    }
  }

  // Helper: Generate embedding for vector storage
  private async generateEmbedding(text: string): Promise<number[]> {
    // Simple hash-based embedding for demo (in production, use proper embeddings)
    const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    const array = new Uint8Array(hash);
    const embedding = Array.from(array.slice(0, 768)).map(x => (x - 127.5) / 127.5);
    return embedding;
  }
}